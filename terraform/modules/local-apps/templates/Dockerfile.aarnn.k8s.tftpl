# syntax=docker/dockerfile:1.7-labs
# Kubernetes-local build for AARNN (C++) using Ubuntu 22.04 build base
# - Full developer libraries installed (Boost, OpenCV, VTK, OpenMPI, FFmpeg, GStreamer, Audio)
# - Robust apt retries to mitigate transient mirror issues
# - Clones upstream repo at the requested ref, builds with CMake/Make
# - Ships a tiny fallback HTTP server serving /health on :8080

ARG TARGET_PAGE_SIZE=4k
FROM ubuntu:22.04 AS build

ENV DEBIAN_FRONTEND=noninteractive

# Install full toolchain + developer libraries with retries
RUN set -eux; \
    apt-get -o Acquire::Retries=3 update; \
    # Base tools and certs
    apt-get install -y --no-install-recommends \
      ca-certificates curl wget gnupg software-properties-common \
      build-essential ninja-build pkg-config cmake git; \
    # Core/common libs
    apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
      libssl-dev libcurl4-openssl-dev libgmp-dev libfftw3-dev \
      libpq-dev libpqxx-dev; \
    # Boost (Ubuntu jammy provides 1.74 with Boost.JSON headers)
    apt-get -o Acquire::Retries=3 install -y --no-install-recommends libboost-all-dev; \
    # OpenCV
    apt-get -o Acquire::Retries=3 install -y --no-install-recommends libopencv-dev; \
    # Graphics/GL/Viz
    apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
      libgl1-mesa-dev libglu1-mesa-dev freeglut3-dev libglew-dev libfreetype6-dev; \
    # VTK + MPI
    apt-get -o Acquire::Retries=3 install -y --no-install-recommends libvtk9-dev libopenmpi-dev; \
    # Audio
    apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
      libasound2-dev portaudio19-dev libpulse-dev libsndfile1-dev; \
    # FFmpeg
    apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
      libavcodec-dev libavformat-dev libavutil-dev libswscale-dev libswresample-dev; \
    # GStreamer
    apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
      libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev gstreamer1.0-plugins-base gstreamer1.0-plugins-good; \
    # Cleanup lists to keep layer smaller
    rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Clone upstream AARNN at the requested ref with fallbacks
ARG AARNN_REF="${aarnn_git_ref}"
RUN set -eux; \
    rm -rf /tmp/aarnn /tmp/aarnn-src || true; \
    success=0; \
    for i in 1 2 3; do \
      git clone --depth 1 --branch "$AARNN_REF" https://github.com/neuralmimicry/aarnn.git /tmp/aarnn && success=1 && break || sleep 2; \
    done; \
    if [ "$success" -eq 1 ]; then \
      cp -a /tmp/aarnn/. /src/; \
    else \
      for i in 1 2 3; do \
        git clone https://github.com/neuralmimicry/aarnn.git /tmp/aarnn && break || sleep 2; \
      done; \
      if [ -d /tmp/aarnn/.git ]; then \
        cd /tmp/aarnn && git fetch --all --tags || true; \
        (git checkout "$AARNN_REF" || true); \
        cp -a /tmp/aarnn/. /src/; \
      fi; \
    fi; \
    if [ ! -f /src/CMakeLists.txt ]; then \
      echo "Git clone failed or missing CMakeLists; attempting tarball"; \
      mkdir -p /tmp/aarnn-src; \
      success_tar=0; \
      for i in 1 2 3; do \
        if curl -fsSL -o /tmp/aarnn.tar.gz "https://codeload.github.com/neuralmimicry/aarnn/tar.gz/refs/heads/$AARNN_REF"; then success_tar=1; break; fi; \
        sleep 2; \
      done; \
      if [ "$success_tar" -ne 1 ]; then \
        for i in 1 2 3; do \
          if curl -fsSL -o /tmp/aarnn.tar.gz "https://codeload.github.com/neuralmimicry/aarnn/tar.gz/$AARNN_REF"; then success_tar=1; break; fi; \
          sleep 2; \
        done; \
      fi; \
      if [ "$success_tar" -eq 1 ] && [ -s /tmp/aarnn.tar.gz ]; then \
        tar -xzf /tmp/aarnn.tar.gz -C /tmp/aarnn-src --strip-components=1 || true; \
        cp -a /tmp/aarnn-src/. /src/ || true; \
      else \
        echo "Tarball fetch failed; proceeding without upstream sources"; \
      fi; \
    fi

# Build with CMake (Ninja if available), fallback to Make; always ensure build dir exists
RUN set -eux; \
    if [ -f CMakeLists.txt ]; then \
      cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release || cmake -S . -B build -DCMAKE_BUILD_TYPE=Release; \
      cmake --build build -j || cmake --build build; \
      (cmake --install build || true); \
    elif [ -f Makefile ] || [ -f makefile ]; then \
      make -j"$(nproc)" || make; \
    else \
      echo "No C++ build metadata found (CMake/Make). Proceeding without building."; \
    fi; \
    mkdir -p /src/build

# Tiny fallback HTTP health server on :8080 serving /health
RUN <<'CPP' g++ -O2 -s -o /usr/local/bin/health_server -x c++ -
#include <arpa/inet.h>
#include <netinet/in.h>
#include <sys/socket.h>
#include <unistd.h>
#include <cstring>
#include <string>
int main(){
  int s = socket(AF_INET, SOCK_STREAM, 0); int opt=1; setsockopt(s,SOL_SOCKET,SO_REUSEADDR,&opt,sizeof(opt));
  sockaddr_in addr{}; addr.sin_family=AF_INET; addr.sin_addr.s_addr=INADDR_ANY; addr.sin_port=htons(8080);
  if(bind(s,(sockaddr*)&addr,sizeof(addr))<0) return 1; if(listen(s,16)<0) return 1;
  while(true){ int c=accept(s,nullptr,nullptr); if(c<0) continue; char buf[1024]; ssize_t n=read(c,buf,sizeof(buf)-1); if(n<0) n=0; buf[n]=0;
    std::string req(buf); bool ok = req.find(" /health ")!=std::string::npos || req.find(" /health?")!=std::string::npos || req.rfind("GET /health",0)==0;
    const char* resp = ok ? "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nContent-Type: text/plain\r\nConnection: close\r\n\r\nOK"
                           : "HTTP/1.1 404 Not Found\r\nContent-Length: 9\r\nContent-Type: text/plain\r\nConnection: close\r\n\r\nNot Found";
    write(c, resp, strlen(resp)); close(c);
  }
}
CPP

FROM ubuntu:22.04 AS runtime
ARG TARGET_PAGE_SIZE
LABEL org.opencontainers.image.source="https://github.com/neuralmimicry/aarnn" \
      org.opencontainers.image.page-size="$${TARGET_PAGE_SIZE}" \
      org.opencontainers.image.description="AARNN C++ runtime with fallback health endpoint"

RUN apt-get -o Acquire::Retries=3 update && apt-get install -y --no-install-recommends \
    ca-certificates bash curl && \
    rm -rf /var/lib/apt/lists/*

# Copy built artifacts (if any) and the fallback health server
WORKDIR /app
COPY --from=build /src/build /app/build
COPY --from=build /src /app/src
COPY --from=build /usr/local/bin/health_server /usr/local/bin/health_server

EXPOSE 8080

# Default: run fallback health server; override CMD to run the actual AARNN binary if known
ENTRYPOINT ["bash", "-lc"]
CMD ["/usr/local/bin/health_server"]
